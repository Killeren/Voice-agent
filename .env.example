# LiveKit Configuration (Required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Cerebras Configuration (Required for AI responses)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Deepgram Configuration (for Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Perplexity API Configuration (Optional - for search functionality)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Railway Configuration (Automatically set by Railway)
PORT=8080
